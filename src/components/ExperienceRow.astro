---
import type { Entry } from '../data/types';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import OrganizationLogo from './OrganizationLogo.astro';
interface Props {
  entry: Entry;
  local?: boolean;
}
const { entry, local = false } = Astro.props;
---

<a
  class="experience-row"
  href={`${local ? '' : '/experience.html'}#${entry.id}`}
>
  {entry.logo ? (
    <OrganizationLogo organization={entry.logo} />
  ) : (
    <Photo media={entry.cover} sizes="136px" />
  )}
  <div>
    <h3>{entry.title}</h3>
    <span class="organization">{entry.organization}</span>
  </div>
  <span class="period mono">{entry.period}</span>
  <Icon />
</a>
